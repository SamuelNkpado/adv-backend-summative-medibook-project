{
  "info": {
    "_postman_id": "6f2d8c1e-medibook-collection-v1",
    "name": "MediBook API",
    "description": "Run in order with the Collection Runner. Before each run: reseed the database (Get-Content database\\seed.sql | mysql -u medibook -p), start the API (npm start), and start the worker (npm run worker). Requests that create data save their IDs into collection variables for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "patientId", "value": "" },
    { "key": "doctorId", "value": "" },
    { "key": "appointmentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "pm.test('service reports ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "List patients",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "pm.test('returns at least the seeded patients', function () { pm.expect(pm.response.json().length).to.be.at.least(3); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/patients" }
        },
        {
          "name": "Create patient",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('patientId', body.patient_id);",
            "pm.test('saves the submitted email', function () { pm.expect(body.patient_email).to.eql('postman.test@mail.com'); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Postman Patient\",\"email\":\"postman.test@mail.com\",\"phone\":\"0700-000-111\"}" },
            "url": "{{baseUrl}}/api/patients"
          }
        },
        {
          "name": "Get created patient",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "pm.test('returns the same patient', function () { pm.expect(pm.response.json().patient_id).to.eql(Number(pm.collectionVariables.get('patientId'))); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/patients/{{patientId}}" }
        },
        {
          "name": "Update created patient",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
            "pm.test('name is updated', function () { pm.expect(pm.response.json().patient_name).to.eql('Postman Patient Updated'); });"
          ] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Postman Patient Updated\",\"email\":\"postman.test@mail.com\",\"phone\":\"0700-000-111\"}" },
            "url": "{{baseUrl}}/api/patients/{{patientId}}"
          }
        },
        {
          "name": "Get patient with invalid ID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
            "pm.test('explains the ID problem', function () { pm.expect(pm.response.json().error).to.include('positive integer'); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/patients/abc" }
        },
        {
          "name": "Get missing patient",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 404', function () { pm.response.to.have.status(404); });"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/patients/999" }
        },
        {
          "name": "Create patient with duplicate email",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 409', function () { pm.response.to.have.status(409); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Duplicate\",\"email\":\"ama@mail.com\",\"phone\":\"0700-111-222\"}" },
            "url": "{{baseUrl}}/api/patients"
          }
        },
        {
          "name": "Create patient with invalid input",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
            "pm.test('lists each problem', function () { pm.expect(pm.response.json().error).to.include('email'); });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"\",\"email\":\"not-an-email\",\"phone\":\"x\"}" },
            "url": "{{baseUrl}}/api/patients"
          }
        },
        {
          "name": "Delete created patient",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status is 204', function () { pm.response.to.have.status(204); });"
          ] } }],
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/patients/{{patientId}}" }
        },
        {
          "name": "Delete patient with appointments (blocked)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
